{
  "name": "differ",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www"
  },
  "dependencies": {
    "cookie-parser": "^1",
    "express": "^4",
    "http-errors": "^2",
    "morgan": "^1",
    "pm2": "^6",
    "postgres": "^3",
    "pug": "^3"
  },
  "devDependencies": {
    "gulp": "^5.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-cli": "^3.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-hash-filename": "^4.1.0",
    "gulp-uglify": "^3.0.2",
    "jasmine": "^5.1.0",
    "merge-stream": "^2.0.0",
    "ordered-read-streams": "^2.0.0"
  },
  "nodemonConfig": {
    "env": {
      "NODE_ENV": "development"
    },
    "ext": "js,json,css",
